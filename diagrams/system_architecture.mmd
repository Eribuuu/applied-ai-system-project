%% Music Recommender + RAG: proof of concept
%% Extends the existing content-based Recommender (src/recommender.py)
%% Solid arrows = data flow. Dotted arrows = reads from cache / testing / human review.
flowchart TB

    %% ===================== People =====================
    LISTENER(["👤 Listener"])
    DEV(["🧑‍💻 Developer"])

    %% ===================== Offline: build once =====================
    subgraph OFFLINE["① Build index once · python -m src.rag.index"]
        RAW[("Spotify Tracks CSV<br/>~114k tracks")]
        PREP["Load + dedupe track_id<br/>→ Song objects"]
        CARDS["Song cards<br/>features → words<br/>'rock — high-energy, dark, fast'"]
        EMBED["Embed cards<br/>fastembed bge-small"]
        CACHE[("Cache · data/index/<br/>songs.parquet · features.npy<br/>embeddings.npy")]
        RAW --> PREP --> CARDS --> EMBED --> CACHE
        PREP --> CACHE
    end

    %% ===================== Online: one query =====================
    subgraph CLI["② CLI · src/main.py"]
        QUERY["Query<br/>'mellow songs for late-night studying'<br/>+ optional --energy, --genre … flags"]
        PRINT["Print top-k songs<br/>+ explanation"]
    end

    subgraph RETRIEVE["③ Hybrid retrieval"]
        DENSE["Dense search<br/>embed query → cosine → top ~300"]
        PROFILE["UserProfile<br/>from flags, else mean features<br/>of top ~20 dense hits"]
        SCORER["Existing Recommender scoring<br/>Gaussian closeness × WEIGHTS<br/>(vectorized with NumPy)"]
        RRF["RRF fusion<br/>+ MIN_SCORE → top-k"]
        DENSE --> PROFILE --> SCORER
        DENSE --> RRF
        SCORER --> RRF
    end

    subgraph GEN["④ Generation"]
        CTX["Context<br/>query + top-k songs + reasons()"]
        LLM{{"Small local LLM<br/>explain the picks"}}
        GUARD{"Guardrail<br/>only retrieved songs?"}
        FALLBACK["Fallback<br/>template reasons()"]
        CTX --> LLM --> GUARD
        GUARD -->|"fail"| FALLBACK
    end

    %% ----- data flow -----
    LISTENER -->|"runs CLI"| QUERY
    QUERY -->|"text"| DENSE
    QUERY -->|"flags"| PROFILE
    CACHE -.-> DENSE
    CACHE -.-> SCORER
    RRF -->|"top-k + reasons"| CTX
    GUARD -->|"pass"| PRINT
    FALLBACK --> PRINT
    PRINT -->|"reads"| LISTENER

    %% ===================== Testing =====================
    subgraph QA["Testing"]
        PARITY["Parity test<br/>vectorized scorer == Recommender<br/>on songs.csv"]
        UNIT["Unit tests<br/>cards · RRF · guardrail (mocked LLM)"]
        EVAL["Retrieval check<br/>~10 labeled queries → hit-rate"]
    end
    PARITY -.->|"checks"| SCORER
    UNIT -.->|"checks"| RRF
    UNIT -.->|"checks"| GUARD
    EVAL -.->|"runs"| RETRIEVE

    %% ----- human in the loop -----
    DEV -.->|"downloads"| RAW
    DEV -.->|"labels queries,<br/>reads hit-rate"| EVAL
    DEV -.->|"spot-checks explanations"| PRINT

    %% ===================== Styling =====================
    classDef human fill:#fde68a,stroke:#b45309,color:#111
    classDef store fill:#e0e7ff,stroke:#4338ca,color:#111
    classDef llm fill:#fbcfe8,stroke:#be185d,color:#111
    classDef test fill:#dcfce7,stroke:#15803d,color:#111

    class LISTENER,DEV human
    class RAW,CACHE store
    class LLM,GUARD,FALLBACK llm
    class PARITY,UNIT,EVAL test
